{
  "name": "milestone",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter @milestone/web build && pnpm --filter @milestone/server build",
    "start": "node apps/server/dist/index.mjs",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d db",
    "db:push": "pnpm --filter @milestone/server db:push",
    "tunnel": "cloudflared tunnel --url http://localhost:8787"
  }
}
