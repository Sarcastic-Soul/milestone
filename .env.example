# PayPal sandbox app (developer.paypal.com > Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX
# Set by `pnpm webhook:register <url>`
PAYPAL_WEBHOOK_ID=
# Sandbox only: a sandbox personal account that receives every payout, so payouts show as paid
SANDBOX_PAYEE_EMAIL=

# Ollama Cloud (ollama.com/settings/keys)
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gemma4:31b

# Postgres. Local: `pnpm db:up`. Hosted: Neon free tier connection string.
DATABASE_URL=postgres://milestone:milestone@localhost:5433/milestone

PORT=8787
# "Today" for due dates and late days. Match the freelancer's time zone.
TZ=Asia/Kolkata
